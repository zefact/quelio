{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quelio",
  "version": "0.8.1",
  "identifier": "jp.co.zefact.quelio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quelio",
        "width": 1160,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMkZDQUE5OUUzRTZFM0UKUldRK2JqNmVxY292NncwZElBdVA3WEdEWjlSZUdBOHkrYm90MDVuSUdjSzVWaHc3cmxNVER3VmoK",
      "endpoints": [
        "https://github.com/zefact/quelio/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ZEFACT Co., Ltd.",
    "homepage": "https://zefact.github.io/quelio/",
    "category": "DeveloperTool",
    "shortDescription": "デスクトップDBクライアント",
    "longDescription": "MySQL / PostgreSQL / SQLite / Valkey に対応した無料のデスクトップDBクライアント。スキーマ比較・ER図・結果キャプチャ・日本語の論理名表示を備えています。",
    "license": "MIT",
    "copyright": "© 2026 ZEFACT Co., Ltd.",
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
